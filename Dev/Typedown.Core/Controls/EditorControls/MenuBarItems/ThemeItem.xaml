<local:MenuBarItemBase
    Title="{u:LocaleString Key=Theme}"
    x:Class="Typedown.Core.Controls.EditorControls.MenuBarItems.ThemeItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.Core.Controls.EditorControls.MenuBarItems"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="using:Typedown.Core.Utilities"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <ToggleMenuFlyoutItem x:Name="UseSystemThemeItem" Text="{u:LocaleString Key=UseSystemSetting}" Click="OnAppThemeItemClick"/>
    <ToggleMenuFlyoutItem x:Name="LightThemeItem" Text="{u:LocaleString Key=View.AppTheme.Light}" Click="OnAppThemeItemClick"/>
    <ToggleMenuFlyoutItem x:Name="DarkThemeItem" Text="{u:LocaleString Key=View.AppTheme.Dark}" Click="OnAppThemeItemClick"/>
    <MenuFlyoutSeparator/>
    <ToggleMenuFlyoutItem x:Name="GitHubItem" Text="GitHub" Click="OnThemeItemClick"/>
    <ToggleMenuFlyoutItem x:Name="MinimalItem" Text="Minimal" Click="OnThemeItemClick"/>
    <ToggleMenuFlyoutItem x:Name="PaperItem" Text="Paper" Click="OnThemeItemClick"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem Text="{u:LocaleString Key=CustomStylesMenuItem}" Click="OnCustomStylesClick"/>
</local:MenuBarItemBase>
